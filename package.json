{
  "name": "financas-pessoais",
  "private": true,
  "version": "1.0.0",
  "description": "App de finanças pessoais: React + Node.js (Express) + SQLite",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node --watch-path=server --watch-preserve-output server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test server/*.test.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
